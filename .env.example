# Public site URL (used for SEO metadata, emails, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Email transport: "console" logs emails to server console (development).
EMAIL_PROVIDER=console

# PayStation Bangladesh Gateway (bKash, Nagad, Rocket, Cards)
# Docs: https://www.paystation.com.bd/documentation
PAYSTATION_MERCHANT_ID=your-merchant-id
PAYSTATION_PASSWORD=your-merchant-password
PAYSTATION_ENV=live
